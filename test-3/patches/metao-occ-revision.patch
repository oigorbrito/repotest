+class MissionRevisionConflict(RuntimeError):
+    """Raised when a write is based on a stale mission revision. Nothing is written."""
+
+    def __init__(self, mission_id: str, expected: int, current: int) -> None:
+        super().__init__(
+            f"mission {mission_id} revision conflict: write based on revision {expected}, current is {current}"
+        )
+        self.mission_id = mission_id
+        self.expected = expected
+        self.current = current
+
+
 class MissionNotFound(KeyError):
     """Raised when a mission record does not exist."""
 
