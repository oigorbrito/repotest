+class InMemoryFencingTests(unittest.TestCase):
+    def test_in_memory_handle_store_applies_the_same_token_rules(self):
+        from metao.execution_handle import InMemoryExecutionHandleStore
+
+        store = InMemoryExecutionHandleStore()
+        a = store.activate(ActiveExecutionHandle("m-1", "exec-A", "runtime-a", 1, 0.0))
+        b = store.activate(ActiveExecutionHandle("m-1", "exec-B", "runtime-b", 2, 1.0))
+        self.assertEqual((a.fencing_token, b.fencing_token), (1, 2))
+        with self.assertRaises(StaleWorkerError):
+            store.complete("m-1", ended_at_epoch=2.0, execution_status=ExecutionStatus.FAILED, fencing_token=a.fencing_token)
+        with self.assertRaises(StaleWorkerError):
+            store.complete("m-1", ended_at_epoch=2.0, execution_status=ExecutionStatus.FAILED)
+        self.assertEqual(store.get("m-1").status, ExecutionHandleStatus.ACTIVE)
+        done = store.complete("m-1", ended_at_epoch=2.0, execution_status=ExecutionStatus.SUCCEEDED, fencing_token=b.fencing_token)
+        self.assertEqual(done.status, ExecutionHandleStatus.COMPLETED)
