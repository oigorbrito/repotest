diff --git a/tests/unit/test_t3_fencing_and_occ.py b/tests/unit/test_t3_fencing_and_occ.py
new file mode 100644
index 0000000..a9628e8
--- /dev/null
+++ b/tests/unit/test_t3_fencing_and_occ.py
@@ -0,0 +1,205 @@
+"""Teste 3: OCC em replace() e validação de fencing token nos caminhos de escrita (SQLite e memória)."""
+
+from __future__ import annotations
+
+from contextlib import closing
+import dataclasses
+from pathlib import Path
+import sqlite3
+import tempfile
+import unittest
+
+from metao.core import ExecutionStatus
+from metao.execution_handle import ActiveExecutionHandle, ActiveExecutionNotFound, ExecutionHandleStatus
+from metao.mission_store import InMemoryMissionStore, MissionRevisionConflict
+from metao.observability import MissionEventKind
+from metao.runtime import StaleWorkerError
+from metao.sqlite_event_ledger import SQLiteEventLedger
+from metao.sqlite_execution_handle import SQLiteExecutionHandleStore
+from metao.sqlite_store import SQLiteMissionStore
+from test_roadmap_1_work_unit_04 import make_record
+
+
+def with_objective(record, text):
+    return dataclasses.replace(record, mission=dataclasses.replace(record.mission, objective=text))
+
+
+def db_objective(path: Path) -> tuple[int, str]:
+    import json
+
+    with closing(sqlite3.connect(path)) as c:
+        revision, raw = c.execute("SELECT revision, record_json FROM mission_records WHERE mission_id='m-1'").fetchone()
+    return revision, json.loads(raw)["mission"]["objective"]
+
+
+def event_rows(path: Path) -> list[tuple[int, str]]:
+    with closing(sqlite3.connect(path)) as c:
+        return c.execute("SELECT sequence, payload_json FROM mission_events WHERE mission_id='m-1' ORDER BY sequence").fetchall()
+
+
+class OccReplaceTests(unittest.TestCase):
+    def setUp(self):
+        self.tmp = tempfile.TemporaryDirectory()
+        self.db = Path(self.tmp.name) / "metao.db"
+
+    def tearDown(self):
+        self.tmp.cleanup()
+
+    def test_stale_revision_is_rejected_and_nothing_is_written(self):
+        store = SQLiteMissionStore(self.db)
+        store.create(make_record("m-1", revision=1))
+        copy_1 = store.get("m-1")
+        copy_2 = store.get("m-1")
+        store.replace(with_objective(copy_1, "rev2 writer 1"))
+
+        with self.assertRaises(MissionRevisionConflict) as ctx:
+            store.replace(with_objective(copy_2, "stale writer 2"))
+        self.assertEqual((ctx.exception.expected, ctx.exception.current), (1, 2))
+        self.assertEqual(db_objective(self.db), (2, "rev2 writer 1"))
+
+    def test_fresh_revision_increments_exactly_once(self):
+        store = SQLiteMissionStore(self.db)
+        store.create(make_record("m-1", revision=1))
+        updated = store.replace(with_objective(store.get("m-1"), "next"))
+        self.assertEqual(updated.revision, 2)
+        self.assertEqual(db_objective(self.db), (2, "next"))
+
+    def test_in_memory_store_applies_the_same_revision_rule(self):
+        store = InMemoryMissionStore()
+        store.create(make_record("m-1", revision=1))
+        copy_1 = store.get("m-1")
+        copy_2 = store.get("m-1")
+        store.replace(with_objective(copy_1, "rev2"))
+        with self.assertRaises(MissionRevisionConflict):
+            store.replace(with_objective(copy_2, "stale"))
+        self.assertEqual(store.get("m-1").mission.objective, "rev2")
+
+    def test_concurrent_writers_from_separate_connections_cannot_both_win(self):
+        store_a = SQLiteMissionStore(self.db)
+        store_b = SQLiteMissionStore(self.db)
+        store_a.create(make_record("m-1", revision=1))
+        base_a = store_a.get("m-1")
+        base_b = store_b.get("m-1")
+        store_a.replace(with_objective(base_a, "a"))
+        with self.assertRaises(MissionRevisionConflict):
+            store_b.replace(with_objective(base_b, "b"))
+        self.assertEqual(db_objective(self.db), (2, "a"))
+
+
+class FencingTests(unittest.TestCase):
+    def setUp(self):
+        self.tmp = tempfile.TemporaryDirectory()
+        self.db = Path(self.tmp.name) / "metao.db"
+        self.missions = SQLiteMissionStore(self.db)
+        self.ledger = SQLiteEventLedger(self.db)
+        self.handles = SQLiteExecutionHandleStore(self.db)
+        self.missions.create(make_record("m-1", revision=1))
+        # Worker A acquires the mission (token 1); worker B takes over (token 2).
+        self.token_a = self.handles.activate(ActiveExecutionHandle("m-1", "exec-A", "runtime-a", 1, 0.0)).fencing_token
+        self.token_b = self.handles.activate(ActiveExecutionHandle("m-1", "exec-B", "runtime-b", 2, 1.0)).fencing_token
+
+    def tearDown(self):
+        self.tmp.cleanup()
+
+    def test_tokens_are_monotonic_and_survive_restart(self):
+        self.assertEqual((self.token_a, self.token_b), (1, 2))
+        restarted = SQLiteExecutionHandleStore(self.db)
+        self.assertEqual(restarted.get("m-1").fencing_token, 2)
+        self.assertEqual(restarted.activate(ActiveExecutionHandle("m-1", "exec-C", "runtime-c", 3, 2.0)).fencing_token, 3)
+
+    def test_stale_append_is_rejected_before_any_sequence_is_allocated(self):
+        self.ledger.append("m-1", MissionEventKind.RUNTIME_STARTED, payload={"by": "B"}, fencing_token=self.token_b)
+        before = event_rows(self.db)
+        with self.assertRaises(StaleWorkerError):
+            self.ledger.append("m-1", MissionEventKind.EVIDENCE_RECORDED, payload={"by": "A"}, fencing_token=self.token_a)
+        self.assertEqual(event_rows(self.db), before)
+
+    def test_current_append_gets_the_next_sequence(self):
+        self.ledger.append("m-1", MissionEventKind.RUNTIME_STARTED, fencing_token=self.token_b)
+        self.ledger.append("m-1", MissionEventKind.EVIDENCE_RECORDED, fencing_token=self.token_b)
