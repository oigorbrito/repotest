diff --git a/src/metao/fencing.py b/src/metao/fencing.py
new file mode 100644
index 0000000..ca85664
--- /dev/null
+++ b/src/metao/fencing.py
@@ -0,0 +1,50 @@
+"""Fencing-token validation shared by the SQLite adapters.
+
+Each guarded write calls ``check_fence`` inside its own ``BEGIN IMMEDIATE`` transaction, before it changes anything.
+Tokens are issued by ``SQLiteExecutionHandleStore.activate()`` and kept in ``active_mission_executions.fencing_token``.
+
+Rules, per mission:
+- A token is given: it must equal the current token. Otherwise ``StaleWorkerError`` is raised and nothing is written.
+- No token is given: the write is rejected while an execution is ``ACTIVE``. Otherwise it is allowed, as before.
+"""
+
+from __future__ import annotations
+
+import sqlite3
+
+from .runtime import StaleWorkerError
+
+ACTIVE_STATUS = "ACTIVE"
+
+
+def handles_table_exists(connection: sqlite3.Connection) -> bool:
+    row = connection.execute(
+        "SELECT 1 FROM sqlite_master WHERE type='table' AND name='active_mission_executions'"
+    ).fetchone()
+    return row is not None
+
+
+def check_fence(connection: sqlite3.Connection, mission_id: str, fencing_token: int | None) -> None:
+    """Raise StaleWorkerError when the write must not happen. Must run inside the write transaction."""
+    if fencing_token is not None and (isinstance(fencing_token, bool) or not isinstance(fencing_token, int)):
+        raise TypeError("fencing token must be an integer")
+    if not handles_table_exists(connection):
+        if fencing_token is None:
+            return
+        raise StaleWorkerError(f"no execution has been activated for mission {mission_id}")
+    row = connection.execute(
+        "SELECT status, fencing_token FROM active_mission_executions WHERE mission_id=?",
+        (mission_id,),
+    ).fetchone()
+    current = None if row is None else int(row[1])
+    if fencing_token is None:
+        if row is not None and str(row[0]) == ACTIVE_STATUS:
+            raise StaleWorkerError(f"mission {mission_id} has an active execution; unfenced write rejected")
+        return
+    if current != fencing_token:
+        raise StaleWorkerError(
+            f"stale fencing token {fencing_token} for mission {mission_id}; current is {current}"
+        )
+
+
+__all__ = ["ACTIVE_STATUS", "check_fence", "handles_table_exists"]
