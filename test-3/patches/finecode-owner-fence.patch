diff --git a/packages/durable/test/sqlite-owner-fence.test.ts b/packages/durable/test/sqlite-owner-fence.test.ts
new file mode 100644
index 0000000..726cd05
--- /dev/null
+++ b/packages/durable/test/sqlite-owner-fence.test.ts
@@ -0,0 +1,71 @@
+import { mkdtemp, rm } from "node:fs/promises";
+import { tmpdir } from "node:os";
+import { join } from "node:path";
+import { DatabaseSync } from "node:sqlite";
+import { BACKGROUND_CONTEXT } from "@earendil-works/chord/context";
+import { afterEach, describe, expect, it } from "vitest";
+import { type SqliteStorage, StaleStorageOwnerError } from "../src/storage/sqlite/index.ts";
+import { openNodeSqliteStorage } from "../src/storage/sqlite/node.ts";
+
+const context = BACKGROUND_CONTEXT;
+const opened: SqliteStorage[] = [];
+const dirs: string[] = [];
+
+afterEach(async () => {
+	for (const storage of opened.splice(0)) await storage.close(context).catch(() => {});
+	for (const dir of dirs.splice(0)) await rm(dir, { recursive: true, force: true });
+});
+
+async function databasePath(): Promise<string> {
+	const dir = await mkdtemp(join(tmpdir(), "pi-durable-fence-"));
+	dirs.push(dir);
+	return join(dir, "durable.sqlite");
+}
+
+describe("SQLite owner fence", () => {
+	it("rejects every commit of an instance superseded by a newer open, and writes nothing", async () => {
+		const path = await databasePath();
+		const older = await openNodeSqliteStorage(path);
+		opened.push(older);
+		const newer = await openNodeSqliteStorage(path);
+		opened.push(newer);
+
+		await expect(older.commit([], context)).rejects.toBeInstanceOf(StaleStorageOwnerError);
+		await expect(older.commit([], context)).rejects.toBeInstanceOf(StaleStorageOwnerError);
+		await expect(newer.commit([], context)).resolves.toBeTypeOf("number");
+	});
+
+	it("fences every earlier open when several instances open in turn", async () => {
+		const path = await databasePath();
+		const instances: SqliteStorage[] = [];
+		for (let i = 0; i < 4; i++) {
+			const storage = await openNodeSqliteStorage(path);
+			opened.push(storage);
+			instances.push(storage);
+		}
+		for (const older of instances.slice(0, -1)) {
+			await expect(older.commit([], context)).rejects.toBeInstanceOf(StaleStorageOwnerError);
+		}
+		await expect(instances.at(-1)?.commit([], context)).resolves.toBeTypeOf("number");
+	});
+
+	it("upgrades a version 2 database by adding the epoch, then fences it", async () => {
+		const path = await databasePath();
+		const first = await openNodeSqliteStorage(path);
+		await first.close(context);
+		const raw = new DatabaseSync(path);
+		raw.exec("ALTER TABLE durable_metadata DROP COLUMN owner_epoch");
+		raw.exec("UPDATE durable_schema SET version = 2 WHERE singleton = 1");
+		raw.close();
+
+		const upgraded = await openNodeSqliteStorage(path);
+		opened.push(upgraded);
+		const check = new DatabaseSync(path, { readOnly: true });
+		const version = check.prepare("SELECT version FROM durable_schema WHERE singleton = 1").get();
+		const epoch = check.prepare("SELECT owner_epoch FROM durable_metadata WHERE singleton = 1").get();
+		check.close();
+		expect(version).toEqual({ version: 3 });
+		expect(epoch).toEqual({ owner_epoch: 1 });
+		await expect(upgraded.commit([], context)).resolves.toBeTypeOf("number");
+	});
+});
