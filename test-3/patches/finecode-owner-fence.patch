+/** Bump the owner epoch in its own transaction; the value this returns is the one this instance owns. */
+async function claimOwnerEpoch(db: SqliteDatabase, schema: SqliteSchema): Promise<number> {
+	return db.transaction(async (transaction) => {
+		await transaction.run(`UPDATE ${schema.tables.durableMetadata} SET owner_epoch = owner_epoch + 1 WHERE singleton = 1`);
+		const row = await transaction.get<{ readonly owner_epoch: number }>(
+			`SELECT owner_epoch FROM ${schema.tables.durableMetadata} WHERE singleton = 1`,
+		);
+		if (row === undefined) throw new Error("Durable SQLite metadata is missing");
+		return Number(row.owner_epoch);
+	});
+}
