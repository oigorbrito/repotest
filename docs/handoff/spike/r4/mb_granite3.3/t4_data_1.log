# Using the assumed structure of sales.json for demonstration
import csv

# Sample sales data
sales_data = [
  {"region": "North", "sales": 1500},
  {"region": "South", "sales": 2100},
  {"region": "East", "sales": 1800},
  {"region": "West", "sales": 2300}
]

# Sort regions by name
sales_data.sort(key=lambda x: x['region'])

# Prepare data for CSV
csv_data = [region['region'] for region in sales_data]

with open('summary.csv', mode='w', newline='') as file:
    writer = csv.writer(file)
    writer.writerow(["region", "total"])  # Write header

    # Write total sales per region
    for region in sales_data:
        total = region['sales']
        writer.writerow([region['region'], total])

# Now, summary.csv will look like:
# region,total
# East,1800
# North,1500
# South,2100
# West,2300
```

