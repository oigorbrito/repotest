```python
import re
import unicodedata

def slugify(text):
    # Normalize string to ASCII, removing accents
    text = unicodedata.normalize('NFKD', text).encode('ASCII', 'ignore').decode('ASCII')
    
    # Replace non-alphanumeric characters with a single hyphen
    text = re.sub(r'[^a-zA-Z0-9\s-]', '', text)
    
    # Trim leading/trailing hyphens
    text = text.strip('-')
    
    # Replace runs of whitespace with a single hyphen
    text = re.sub(r'\s+', '-', text)
    
    # Convert to lowercase
    text = text.lower()
    
    return text

# Example usage:
# Assuming the test_textutil.py has a function to check slugify
# and you need to ensure it passes with the above implementation

# Sample input to test
sample_input = "This is a Test String with Accents: Éàçíüø!"

# Apply slugify to the sample input
