import pytest
import datetime
from dates import to_iso, today

def test_to_iso():
    assert to_iso("2022/01/01") == "2022-01-01"

def test_today():
    today_str = today()
    assert to_iso(today_str.split("/")) == today_str

if __name__ == "__main__":
    import os
    os.system("source test_dates_env/bin/activate")
    pytest.main()
```

